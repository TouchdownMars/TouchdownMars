# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Unreal project must sit at the repository root (next to this file) for the rules above to apply.

# Third-party assets that are not open source must never reach this public repository.
# Quixel Bridge imports go to Content/Megascans and Content/MSPresets; Fab imports go to Content/Fab.
# Check the actual import folder after the first import and add it here if it differs.
**/Content/Megascans/
**/Content/MSPresets/
**/Content/Fab/

# Packaged game builds: publish through GitHub Releases, not git.
Packaged/
Windows/
*.zip
*.7z

# Team additions (14.11.2026)
# Packaged builds made by Scripts/package.ps1
Builds/
# Plugins kept out of the public repo
# UnrealMCPServer: private team fork of a Fab product (licence forbids redistribution)
# VibeUE: MIT editor tooling, installed from https://github.com/kevinpbuckley/VibeUE
Plugins/UnrealMCPServer/
Plugins/VibeUE/
# Local machine files
*.log
.DS_Store
Thumbs.db
